# Base URL for the backend REST API (trailing /api included)
VITE_API_BASE=http://localhost:7867/api

# Origin of the backend server (used for socket.io and media URL resolution)
VITE_SERVER_ORIGIN=http://localhost:7867

# Root domain for per-event subdomains (e.g. <subdomain>.streamconference.com)
# Use "localhost" for local development (visit http://<subdomain>.localhost:5174)
VITE_ROOT_DOMAIN=localhost
